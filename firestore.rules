rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if user is admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email in [
        "hasanzuke@gmail.com"
      ];
    }

    // Helper: check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.token.email == userId;
    }

    // ===== USERS COLLECTION =====
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated();
      // Users can only update their own profile (limited fields)
      allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'credits', 'lastReset', 'adsWatchedToday', 'lastSeen',
        'checkinStreak', 'lastCheckin', 'displayName', 'photoURL'
      ]);
      // Only server/admin can create users
      allow create: if false;
      // No one can delete users
      allow delete: if false;
    }

    // ===== GAMES COLLECTION =====
    match /games/{gameId} {
      // Anyone can read published games
      allow read: if resource.data.status == 'published' || isOwner(resource.data.authorId);
      // Authenticated users can create games (limit enforced server-side)
      allow create: if isAuthenticated();
      // Only owner or admin can update
      allow update: if isOwner(resource.data.authorId) || isAdmin();
      // Only admin can delete
      allow delete: if isAdmin();

      // ===== COMMENTS SUBCOLLECTION =====
      match /comments/{commentId} {
        // Anyone can read comments
        allow read: if true;
        // Authenticated users can create comments
        allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.token.email;
        // Only comment owner or admin can update
        allow update: if request.resource.data.authorId == request.auth.token.email || isAdmin();
        // Only comment owner or admin can delete
        allow delete: if resource.data.authorId == request.auth.token.email || isAdmin();
      }
    }
  }
}
